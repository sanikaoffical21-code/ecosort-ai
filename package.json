{
  "name": "ecosort-ai",
  "version": "1.0.0",
  "description": "EcoSort AI – Smart Waste Management & Community Action",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"green,blue\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"green,blue\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "prod": "node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2"
  }
}
